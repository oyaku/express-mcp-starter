PORT=3000
# MCP HTTP 端口。注意 http-mcp.ts 里 PORT 优先（PaaS 只注入 PORT），
# 所以别把上面那个 PORT=3000 一起导出给 MCP 进程，否则会和 app.ts 抢端口
MCP_PORT=3001
# http-mcp 的访问令牌，必填，缺了服务直接拒绝启动
# 生成：node -e "console.log(crypto.randomUUID())"
MCP_AUTH_TOKEN=
# 验证远端 MCP 时用：MCP_URL=https://你的域名/mcp node test/verify-http-tool.mjs
MCP_URL=
# 去 https://github.com/settings/tokens 申请，只需 public_repo 权限，可不填
GITHUB_TOKEN=
