{
  "name": "express-mcp-starter",
  "version": "1.0.0",
  "description": "Express老炮转MCP starter: 同一份service, REST + MCP Stdio + MCP HTTP 三吃",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev:api": "tsx watch src/app.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "dev:mcp:http": "tsx watch src/http-mcp.ts",
    "start": "node --import tsx/esm src/app.ts",
    "start:mcp": "node dist/http-mcp.js",
    "build": "tsc",
    "test": "node --import tsx/esm test/smoke.mjs"
  },
  "keywords": ["express", "mcp", "claude", "node", "fullstack", "ai-agent"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
